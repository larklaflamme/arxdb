		"@types/d3-zoom": "^3.0.8",
		"@types/node": "^26.3.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@sveltejs/adapter-node": "^5.5.7",
